    "seed": "ts-node scripts/seed.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
